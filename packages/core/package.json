{
  "name": "@tailwindcss-mangle/core",
  "type": "module",
  "version": "6.0.2",
  "description": "The core of tailwindcss-mangle",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "MIT",
  "homepage": "https://mangle.icebreaker.top/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonofmagic/tailwindcss-mangle.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/sonofmagic/tailwindcss-mangle/issues"
  },
  "keywords": [
    "tailwindcss",
    "patch",
    "core",
    "mangle"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "tsdown --watch --sourcemap",
    "build": "tsdown",
    "test": "vitest run --coverage.enabled",
    "test:dev": "vitest",
    "test:types": "pnpm build && tsd --typings dist/index.d.ts --files test-d/**/*.test-d.ts",
    "coverage": "vitest run --coverage"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "dependencies": {
    "@babel/types": "^8.0.6",
    "@jridgewell/remapping": "^2.3.5",
    "@tailwindcss-mangle/config": "workspace:*",
    "@tailwindcss-mangle/native": "workspace:*",
    "@tailwindcss-mangle/shared": "workspace:*",
    "@vue/compiler-sfc": "^3.5.43",
    "defu": "^6.1.7",
    "fast-sort": "^3.4.1",
    "fs-extra": "^11.4.1",
    "magic-string": "^1.4.2",
    "pathe": "^2.0.3",
    "postcss": "^8.5.28",
    "svelte": "^5.57.1",
    "unplugin": "^3.4.0"
  },
  "tsd": {
    "compilerOptions": {
      "module": "NodeNext"
    }
  },
  "devDependencies": {
    "@babel/parser": "^8.0.6",
    "@babel/traverse": "^8.0.6",
    "postcss-selector-parser": "^7.1.6"
  }
}

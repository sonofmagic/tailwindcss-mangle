{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "test",
    "dev"
  ],
  "exclude": [
    "dist",
    "coverage",
    "node_modules",
    "test/fixtures/**/*"
  ]
}

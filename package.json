{
  "name": "tailwindcss-mangle",
  "type": "module",
  "version": "4.0.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" --workspace-concurrency=1 run build",
    "dev": "pnpm -r run dev",
    "test": "pnpm -r --filter \"./packages/*\" --workspace-concurrency=1 run test",
    "test:types": "pnpm -r --filter \"./packages/*\" --workspace-concurrency=1 run test:types",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "lint:style": "pnpm exec stylelint \"{website,packages,apps}/**/*.{css,scss}\" --allow-empty-input --ignore-pattern \"packages/**/bench/generated/**\" --ignore-pattern \"apps/**/tailwind.generated.css\"",
    "test:e2e": "pnpm run test:e2e:apps",
    "test:e2e:apps": "cross-env TWM_APPS_E2E=1 vitest run --config e2e/vitest.config.ts e2e/apps.e2e.test.ts e2e/process.test.ts",
    "test:e2e:pw": "pnpm run test:e2e:apps:pw",
    "test:e2e:apps:pw": "cross-env TWM_APPS_E2E_PLAYWRIGHT=1 vitest run --config e2e/vitest.config.ts e2e/apps.playwright.e2e.test.ts",
    "test:e2e:hmr": "pnpm run test:e2e:apps:hmr",
    "test:e2e:apps:hmr": "cross-env TWM_APPS_E2E_HMR=1 vitest run --config e2e/vitest.config.ts e2e/apps.hmr.e2e.test.ts",
    "test:e2e:all": "pnpm run test:e2e:apps && pnpm run test:e2e:apps:pw && pnpm run test:e2e:apps:hmr",
    "test:dev": "vitest",
    "build:docs": "turbo run build --filter=./website",
    "lint": "eslint \"packages/**/*.ts\" packages/tailwindcss-patch/tsdown.config.mts \"e2e/**/*.ts\" \"*.config.{js,ts}\" scripts/check-package-boundaries.mjs scripts/clean.mjs scripts/postcss7-compat/index.js --ignore-pattern \"packages/**/bench/**\" --ignore-pattern \"packages/**/test-d/**\" --fix",
    "preinstall": "npx only-allow pnpm",
    "sync": "cnpm sync @tailwindcss-mangle/shared @tailwindcss-mangle/config @tailwindcss-mangle/engine tailwindcss-patch unplugin-tailwindcss-mangle @tailwindcss-mangle/core",
    "publish-packages": "repo release stable publish",
    "release": "pnpm change",
    "release:verify": "pnpm lint && pnpm lint:style && pnpm check:boundaries && pnpm build && pnpm typecheck && pnpm test:types && pnpm test && pnpm build:docs && pnpm test:e2e:all",
    "pr": "repo release pre enter alpha",
    "pr:beta": "repo release pre enter beta",
    "pr:rc": "repo release pre enter rc",
    "pr:exit": "repo release pre exit",
    "cv": "pnpm version -r",
    "script:init": "repo init",
    "script:sync": "pnpm run sync",
    "script:clean": "node scripts/clean.mjs",
    "script:mirror": "repo env mirror",
    "commitlint": "commitlint --edit",
    "typecheck": "pnpm -r --filter \"./packages/*\" --workspace-concurrency=1 exec tsc --noEmit && pnpm --filter @tailwindcss-mangle/website types:check",
    "prepare": "husky",
    "release:plan": "repo release plan --json",
    "version-packages": "pnpm version -r",
    "release:pre": "repo release pre publish",
    "repo:init": "repo init",
    "repo:new": "repo new",
    "repo:check": "repo check",
    "repo:doctor": "repo doctor"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@playwright/test": "^1.63.0",
    "@rollup/pluginutils": "^5.4.0",
    "@tailwindcss-mangle/core": "workspace:*",
    "@tailwindcss-mangle/shared": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@tsconfig/recommended": "^1.0.13",
    "@types/fs-extra": "^11.0.4",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/klaw": "^3.0.8",
    "@types/lodash": "^4.17.25",
    "@types/lodash-es": "^4.17.12",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^26.6.4",
    "@types/resolve": "^1.20.6",
    "@types/semver": "^7.8.0",
    "@types/set-value": "^4.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "astro": "^7.3.5",
    "ci-info": "^4.4.0",
    "comment-json": "^5.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "dedent": "^1.7.2",
    "defu": "^6.1.7",
    "del": "^8.0.1",
    "dotenv": "^18.0.5",
    "es-toolkit": "^1.52.0",
    "eslint": "^10.12.0",
    "execa": "^10.0.1",
    "fast-glob": "^3.3.3",
    "fdir": "^6.5.0",
    "fs-extra": "^11.4.1",
    "get-value": "^4.1.0",
    "html-minifier-terser": "^7.2.0",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "klaw": "^4.1.0",
    "lint-staged": "^17.6.0",
    "local-pkg": "^1.2.1",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "micromatch": "^4.0.8",
    "mini-css-extract-plugin": "^2.10.2",
    "normalize-newline": "^5.0.0",
    "only-allow": "^1.2.2",
    "pathe": "^2.0.3",
    "picomatch": "^4.0.7",
    "pkg-types": "^2.3.3",
    "postcss": "^8.5.28",
    "postcss-loader": "^8.2.1",
    "postcss7": "npm:postcss@^7.0.39",
    "prettier": "^3.9.9",
    "repoctl": "5.7.1",
    "rimraf": "^6.1.3",
    "rollup": "^4.64.0",
    "set-value": "^4.1.0",
    "stylelint": "^17.16.0",
    "tailwindcss": "catalog:tailwindcss4",
    "tailwindcss-patch": "workspace:*",
    "tailwindcss2": "catalog:tailwindcss2",
    "tsd": "^0.33.0",
    "tsdown": "^0.23.0",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "type-fest": "^5.10.0",
    "typescript": "6.0.3",
    "unplugin": "^3.4.0",
    "unplugin-tailwindcss-mangle": "workspace:*",
    "vite": "^8.3.2",
    "vitest": "5.0.3",
    "webpack": "^5.111.1",
    "webpack-build-utils": "^0.0.7",
    "yaml": "^2.9.1"
  }
}
